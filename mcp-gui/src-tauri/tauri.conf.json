{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tianshu-mcp Logs",
  "version": "0.1.0-beta.1",
  "identifier": "com.tianshu.mcp.logs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tianshu-mcp 日志台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/lanlan0811/tianshu-mcp/master/update/gui/latest.json",
        "https://gitee.com/lan0811/tianshu-mcp/raw/master/update/gui/latest-gitee.json"
      ],
      "pubkey": "__UPDATER_PUBKEY__"
    }
  }
}