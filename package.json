{
  "name": "tianshu-mcp",
  "version": "0.1.10",
  "description": "天枢 × AI-Agent 编排 MCP server —— 由天枢调度本 server 去驱动外部 AI-Agent（Codex CLI、TraeWork GUI）完成 项目开发 → 验收 → 失败返修 → 再验收 的闭环。",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanlan0811/tianshu-mcp.git"
  },
  "homepage": "https://github.com/lanlan0811/tianshu-mcp#readme",
  "bugs": {
    "url": "https://github.com/lanlan0811/tianshu-mcp/issues"
  },
  "bin": {
    "tianshu-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "scripts/probe-zcode.mjs",
    "scripts/smoke-zcode.mjs",
    "scripts/prepare-zcode-fixture.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "build": "npm run sync-version && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "check:stdio": "node scripts/check-stdio.mjs --entry dist/index.js",
    "check:stdio:src": "node scripts/check-stdio.mjs --entry src/index.ts --tsx",
    "smoke:zcode": "node scripts/smoke-zcode.mjs",
    "fixture:zcode": "node scripts/prepare-zcode-fixture.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "cross-spawn": "^7.0.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "orchestration",
    "codex",
    "zcode",
    "traework",
    "tianshu"
  ]
}
