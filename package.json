{
  "name": "tianshu-mcp",
  "version": "0.7.0",
  "description": "天枢 × AI-Agent 编排 MCP server —— 驱动 Codex、TraeWork、ZCode、Kimi Code 与 Qoder CN 完成项目开发、验收、失败返修与再验收闭环。",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanlan0811/tianshu-mcp.git"
  },
  "homepage": "https://github.com/lanlan0811/tianshu-mcp#readme",
  "bugs": {
    "url": "https://github.com/lanlan0811/tianshu-mcp/issues"
  },
  "bin": {
    "tianshu-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "docs/event-stream.md",
    "docs/event-stream.en.md",
    "docs/repair-directives.md",
    "docs/repair-directives.en.md",
    "docs/dry-run.md",
    "docs/dry-run.en.md",
    "docs/notifications.md",
    "docs/notifications.en.md",
    "docs/visual-acceptance.md",
    "docs/visual-acceptance.en.md",
    "docs/visual-validation.md",
    "docs/visual-validation.en.md",
    "docs/visual-validation-evidence",
    "scripts/probe-traework.mjs",
    "scripts/probe-zcode.mjs",
    "scripts/probe-codex.mjs",
    "scripts/probe-kimicode.mjs",
    "scripts/probe-qoder.mjs",
    "scripts/probe-opendesign.mjs",
    "docs/qoder-cdp.md",
    "docs/qoder-cdp.en.md",
    "docs/opendesign-cdp.md",
    "docs/opendesign-cdp.en.md",
    "docs/gui-log-viewer.md",
    "docs/gui-log-viewer.en.md",
    "docs/qoder-evidence",
    "scripts/smoke-zcode.mjs",
    "scripts/prepare-zcode-fixture.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "scripts/gitee-release.mjs",
    "scripts/release-body.mjs",
    "scripts/evidence-visual-windows.mjs"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "build": "npm run sync-version && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "check:stdio": "node scripts/check-stdio.mjs --entry dist/index.js",
    "check:stdio:src": "node scripts/check-stdio.mjs --entry src/index.ts --tsx",
    "seed:skill-state": "node scripts/seed-skill-state.mjs",
    "smoke:zcode": "node scripts/smoke-zcode.mjs",
    "probe:traework": "node scripts/probe-traework.mjs",
    "probe:zcode": "node scripts/probe-zcode.mjs",
    "probe:codex": "node scripts/probe-codex.mjs",
    "probe:kimicode": "node scripts/probe-kimicode.mjs",
    "probe:qoder": "node scripts/probe-qoder.mjs",
    "probe:opendesign": "node scripts/probe-opendesign.mjs",
    "fixture:zcode": "node scripts/prepare-zcode-fixture.mjs",
    "pack:check": "npm pack --dry-run",
    "evidence:visual:windows": "node scripts/evidence-visual-windows.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@puppeteer/browsers": "2.13.2",
    "cross-spawn": "^7.0.6",
    "pixelmatch": "7.2.0",
    "puppeteer-core": "24.43.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "orchestration",
    "codex",
    "zcode",
    "traework",
    "kimicode",
    "tianshu"
  ],
  "optionalDependencies": {
    "sharp": "0.34.5"
  }
}
